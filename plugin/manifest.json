{
  "schemaVersion": 1,
  "id": "org.sefaria.otzaria-english",
  "name": "תרגום אנגלית",
  "version": "0.0.1",
  "description": "English translations from Sefaria for whatever you are reading in Otzaria. Six view modes, fully offline, per-passage source attribution.",
  "author": "otsaplugin contributors",
  "homepage": "https://github.com/mgsmath/otsaplugin",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "minAppVersion": "0.9.96",
  "sdkVersion": "1.x",
  "stability": "beta",
  "permissions": [
    "app.startup_contributions",
    "reader.context_menu",
    "reader.open",
    "library.books.read",
    "fs.user_files.read",
    "app.open_url",
    "events.subscribe:reader.current_ref_changed"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "toolTab": {
      "title": "תרגום אנגלית",
      "order": 320,
      "defaultPinned": true,
      "iconName": "book_24_regular"
    },
    "startup": {
      "contextMenuItems": [
        {
          "id": "english-translation",
          "type": "item",
          "title": "תרגום לאנגלית",
          "icon": "fluent:translate_24_regular",
          "openPlugin": true,
          "param": "peek"
        }
      ]
    },
    "publishedDataTypes": []
  }
}
